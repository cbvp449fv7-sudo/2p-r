{
  "name": "areej-shawly",
  "version": "1.0.0",
  "private": true,
  "description": "موقع أريج شاولي للخياطة — أطقم الصلاة والتوربان وطرح الحجاب",
  "scripts": {
    "build": "npm run build:css && node build.mjs",
    "build:css": "tailwindcss -i assets/css/tailwind.css -o assets/css/site.css --minify",
    "check": "node build.mjs --check",
    "watch": "tailwindcss -i assets/css/tailwind.css -o assets/css/site.css --watch",
    "serve": "python3 -m http.server 8080",
    "start": "npm run build && npm run serve",
    "validate:html": "html-validate index.html products.html sizes.html \"product/**/*.html\""
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "html-validate": "^11.11.0",
    "tailwindcss": "^3.4.0"
  }
}